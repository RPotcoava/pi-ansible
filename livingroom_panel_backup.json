{
  "views": [
    {
      "title": "Living Room",
      "path": "living_room",
      "icon": "mdi:sofa",
      "type": "masonry",
      "cards": [
        {
          "type": "vertical-stack",
          "cards": [
            {
              "type": "custom:mushroom-template-card",
              "icon": "{% set hr = now().hour %}{% if hr >= 6 and hr < 12 %}mdi:weather-sunny{% elif hr >= 12 and hr < 18 %}mdi:weather-partly-cloudy{% elif hr >= 18 and hr < 22 %}mdi:weather-sunset{% else %}mdi:weather-night{% endif %}",
              "icon_color": "{% set hr = now().hour %}{% if hr >= 6 and hr < 18 %}orange{% else %}indigo{% endif %}",
              "primary": "{% set hr = now().hour %}{% if hr >= 6 and hr < 12 %}Good Morning{% elif hr >= 12 and hr < 18 %}Good Afternoon{% elif hr >= 18 and hr < 22 %}Good Evening{% else %}Good Night{% endif %}, Razvan",
              "secondary": "Temp: {{ states('sensor.everything_presence_livingroom_temperature') | round(1) }}\u00b0C | Humidity: {{ states('sensor.everything_presence_livingroom_humidity') | round(0) }}% | Lux: {{ states('sensor.everything_presence_livingroom_illuminance') | round(0) }}",
              "layout": "vertical"
            },
            {
              "type": "custom:mushroom-chips-card",
              "alignment": "center",
              "chips": [
                {
                  "type": "template",
                  "entity": "binary_sensor.everything_presence_livingroom_occupancy",
                  "icon": "mdi:motion-sensor",
                  "icon_color": "{{ 'green' if is_state('binary_sensor.everything_presence_livingroom_occupancy', 'on') else 'grey' }}",
                  "content": "Occupied"
                },
                {
                  "type": "template",
                  "entity": "binary_sensor.livingroom_window_sensor_1",
                  "icon": "{{ 'mdi:window-open-variant' if is_state('binary_sensor.livingroom_window_sensor_1', 'on') else 'mdi:window-closed-variant' }}",
                  "icon_color": "{{ 'red' if is_state('binary_sensor.livingroom_window_sensor_1', 'on') else 'blue' }}",
                  "content": "Window"
                },
                {
                  "type": "template",
                  "entity": "sensor.livingroom_energy",
                  "icon": "mdi:flash",
                  "icon_color": "amber",
                  "content": "{{ states('sensor.livingroom_energy') | round(1) }} kWh"
                }
              ]
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.klippbok_water_leak_sensor_water_leak",
                  "state": "on"
                }
              ],
              "card": {
                "type": "custom:mushroom-template-card",
                "primary": "KLIPPBOK: Water Leak Detected!",
                "secondary": "Check location immediately!",
                "icon": "mdi:water-alert",
                "icon_color": "red",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.klippbok_water_leak_sensor_water_leak",
                  "state": "unavailable"
                }
              ],
              "card": {
                "type": "custom:mushroom-template-card",
                "primary": "KLIPPBOK Leak Sensor Offline",
                "secondary": "Sensor is unavailable (battery drained?)",
                "icon": "mdi:water-off",
                "icon_color": "orange",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.ikea_of_sweden_badring_water_leakage_sensor_moisture",
                  "state": "on"
                }
              ],
              "card": {
                "type": "custom:mushroom-template-card",
                "primary": "BADRING: Water Leak Detected!",
                "secondary": "Check location immediately!",
                "icon": "mdi:water-alert",
                "icon_color": "red",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.ikea_of_sweden_badring_water_leakage_sensor_moisture",
                  "state": "unavailable"
                }
              ],
              "card": {
                "type": "custom:mushroom-template-card",
                "primary": "BADRING Leak Sensor Offline",
                "secondary": "Sensor is unavailable (battery drained?)",
                "icon": "mdi:water-off",
                "icon_color": "orange",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.natgas_sensor_158d00035a8b85",
                  "state": "on"
