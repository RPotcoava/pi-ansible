                "icon_color": "red",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.natgas_sensor_158d00035a8b85",
                  "state": "unavailable"
