                "icon": "mdi:battery-alert",
                "icon_color": "orange",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "sensor.curtain_3_9a96_battery",
