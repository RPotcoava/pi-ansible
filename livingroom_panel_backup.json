                    "action": "call-service",
                    "service": "cover.open_cover",
                    "target": {
                      "entity_id": "cover.livingroom_curtain"
                    }
                  }
                },
                {
                  "type": "custom:mushroom-template-card",
                  "primary": "Close Curtains",
                  "secondary": "All Covers",
                  "icon": "mdi:arrow-down-bold-circle-outline",
                  "icon_color": "blue",
                  "tap_action": {
                    "action": "call-service",
                    "service": "cover.close_cover",
                    "target": {
                      "entity_id": "cover.livingroom_curtain"
                    }
