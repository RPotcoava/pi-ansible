                "secondary": "Danger! Check kitchen immediately!",
                "icon": "mdi:smoke-detector-alert",
                "icon_color": "red",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.smoke_sensor_158d0002ad1027",
                  "state": "unavailable"
                }
              ],
              "card": {
                "type": "custom:mushroom-template-card",
                "primary": "Kitchen Smoke Detector Offline",
                "secondary": "Sensor is unavailable",
                "icon": "mdi:alert-circle-outline",
                "icon_color": "orange",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "numeric_state",
                  "entity": "sensor.curtain_3_9a96_battery",
