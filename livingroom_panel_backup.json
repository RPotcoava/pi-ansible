                "icon_color": "red",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "numeric_state",
                  "entity": "sensor.curtain_3_a832_battery",
                  "below": 20
                }
              ],
              "card": {
                "type": "custom:mushroom-template-card",
                "primary": "Right Curtain Battery Low",
                "secondary": "Battery level is {{ states('sensor.curtain_3_a832_battery') }}%",
                "icon": "mdi:battery-alert",
                "icon_color": "orange",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "sensor.curtain_3_a832_battery",
                  "state": "unavailable"
                }
