                        },
                        {
                          "type": "custom:mushroom-template-card",
                          "primary": "Play Xbox",
                          "secondary": "Harmony Activity",
                          "icon": "mdi:microsoft-xbox",
                          "icon_color": "green",
                          "tap_action": {
                            "action": "call-service",
                            "service": "remote.turn_on",
                            "target": {
                              "entity_id": "remote.main_room"
                            },
                            "data": {
                              "activity": "Joaca XBOX"
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "type": "conditional",
                    "conditions": [
                      {
                        "condition": "state",
                        "entity": "remote.main_room",
                        "state": "on"
                      }
                    ],
                    "card": {
                      "type": "custom:mushroom-template-card",
