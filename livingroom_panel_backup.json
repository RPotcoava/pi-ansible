                "icon": "mdi:alert-circle-outline",
                "icon_color": "orange",
                "layout": "horizontal"
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "binary_sensor.smoke_sensor_158d0002ad1027",
                  "state": "on"
