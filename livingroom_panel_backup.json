                  {
                    "type": "custom:mushroom-cover-card",
                    "entity": "cover.livingroom_curtain",
                    "name": "Main Curtains",
                    "show_position_control": true,
                    "show_tilt_position_control": false
                  },
                  {
                    "type": "conditional",
                    "conditions": [
                      {
                        "condition": "state",
                        "entity": "input_boolean.heating",
                        "state": "on"
                      }
                    ],
                    "card": {
                      "type": "custom:mushroom-climate-card",
                      "entity": "climate.livingroom_wall_thermostat_1",
                      "name": "Wall Heating",
                      "hvac_modes": [
                        "off",
                        "heat"
                      ],
                      "show_temperature_control": true
                    }
                  }
                ]
              }
            },
            {
              "type": "conditional",
              "conditions": [
                {
                  "condition": "state",
                  "entity": "sun.sun",
                  "state": "below_horizon"
                }
              ],
              "card": {
                "type": "vertical-stack",
                "cards": [
                  {
                    "type": "custom:mushroom-title-card",
