{
  "id": "1671216460188",
  "alias": "LV: Set Wall Lights to desired level",
  "description": "Sets the LV Wall Lights Level to desired updated value",
  "triggers": [
    {
      "entity_id": [
        "input_number.light_level"
      ],
      "trigger": "state"
    }
  ],
  "conditions": [
    {
      "condition": "and",
      "conditions": [
        {
          "condition": "state",
          "entity_id": "group.walllight",
          "state": "on"
        },
        {
          "condition": "state",
          "entity_id": "input_boolean.light_override",
          "state": "off"
        }
      ]
    }
  ],
  "actions": [
    {
      "data": {
        "transition": 3,
        "color_temp_kelvin": "{{ states(\"input_number.lights_color\") | int }}",
        "brightness_pct": "{{ states(\"input_number.light_level\") | int }}"
      },
      "target": {
        "entity_id": [
          "light.tradfri_bulb_9",
          "light.tradfri_bulb_10"
        ]
      },
      "action": "light.turn_on"
    }
  ],
  "mode": "single"
}