{
  "id": "1638618183548",
  "alias": "MB: Maria's Air Purifier OFF when open window",
  "description": "Turns off Maria air purifier and heating when window has been open for 10 minutes.",
  "triggers": [
    {
      "entity_id": "binary_sensor.maria_s_bedroom_window_sensor_1",
      "from": "off",
      "to": "on",
      "for": {
        "minutes": 10
      },
      "trigger": "state"
    }
  ],
  "conditions": [],
  "actions": [
    {
      "data": {
        "entity_id": "media_player.sufragerie_speaker",
        "message": "OK, turning off the air purifier"
      },
      "action": "tts.cloud_say"
    },
    {
      "action": "fan.turn_off",
      "target": {
        "entity_id": "fan.mi_air_purifier_3_3h"
      }
    },
    {
      "action": "climate.set_hvac_mode",
      "data": {
        "hvac_mode": "off"
      },
      "target": {
        "entity_id": "climate.maria_s_bedroom_radiator_thermostat_1"
      }
    },
    {
      "action": "climate.set_temperature",
      "data": {
        "temperature": 12,
        "hvac_mode": "off"
      },
      "target": {
        "entity_id": "climate.maria_s_bedroom_radiator_thermostat_1"
      }
    }
  ],
  "mode": "single"
}